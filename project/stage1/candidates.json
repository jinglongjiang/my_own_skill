      "parameters": {"alpha": 10.0, "fit_intercept": true, "solver": "cholesky"},
      "decision": "argmax predicted G_A among all eligible candidates"
    },
    {
      "id": "C02",
      "estimator": "sklearn.ensemble.HistGradientBoostingRegressor",
      "target": "G_A",
      "preprocessing": "none",
