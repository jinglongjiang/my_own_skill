  "feature_names": ["reward", "value", "clearance", "command_vx", "command_vy", "command_speed", "baseline_rank", "gap_to_first", "pred_terminal"],
  "source_allowlist": ["rewards", "values", "clearance", "commands", "final_scores", "pred_terminal", "eligible"],
  "sample_weight": "1 / number of eligible candidates in the root; every training root has total weight 1",
  "fit_timeout_seconds": 1200,
  "cpu_threads": 2,
