      "decision": "argmax predicted G_A among all eligible candidates"
    },
    {
      "id": "C03",
      "estimator": "sklearn.ensemble.HistGradientBoostingClassifier",
      "target": "1 if branch_outcome != success else 0",
      "preprocessing": "none",
      "parameters": {"loss": "log_loss", "learning_rate": 0.05, "max_iter": 120, "max_leaf_nodes": 15, "max_depth": null, "min_samples_leaf": 100, "l2_regularization": 1.0, "max_bins": 64, "early_stopping": false, "random_state": 271828},
      "k": 5,
      "lambda": 0.1,
      "decision": "argmax final_scores - 0.1 * predicted failure probability within baseline top 5 eligible candidates"
    }
  ]
}
